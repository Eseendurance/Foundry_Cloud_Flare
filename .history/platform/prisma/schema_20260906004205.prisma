// 1. Prisma Data Source & Generator Setup
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 2. Enums
enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

enum KeyStatus {
  ACTIVE
  REVOKED
}

enum DeploymentStatus {
  PENDING
  BUILDING
  DEPLOYED
  FAILED
}

// 3. Organizations (Workspaces)
model Organization {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  planTier         PlanTier @default(FREE) @map("plan_tier")
  stripeCustomerId String?  @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  apiKeys          ApiKey[]
  tables           TableSchema[]
  deployments      Deployment[]

  @@map("organizations")
}

// 4. Platform API Keys (Hashed Storage)
model ApiKey {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  keyHash      String    @unique @map("key_hash")
  keyPrefix    String    @map("key_prefix") // e.g. "fg_live_9a2b"
  label        String
  status       KeyStatus @default(ACTIVE)
  monthlyQuota Int       @default(1000) @map("monthly_quota")
  currentUsage Int       @default(0) @map("current_usage")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requestLogs  ApiRequestLog[]

  @@map("api_keys")
}

// 5. API Gateway Request Audit Logs
model ApiRequestLog {
  id         String   @id @default(uuid()) @db.Uuid
  keyId      String   @map("key_id") @db.Uuid
  endpoint   String
  action     String
  statusCode Int      @map("status_code")
  latencyMs  Int      @map("latency_ms")
  timestamp  DateTime @default(now())

  apiKey ApiKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@map("api_request_logs")
}

// 6. User Relational Table Schemas
model TableSchema {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  tableName    String   @map("table_name")
  columnsJson  Json     @map("columns_json") // Stores column definitions array
  createdAt    DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, tableName])
  @@map("table_schemas")
}

// 7. Hosted Deployments
model Deployment {
  id            String           @id @default(uuid()) @db.Uuid
  orgId         String           @map("org_id") @db.Uuid
  appName       String           @map("app_name")
  deploymentUrl String           @map("deployment_url")
  status        DeploymentStatus @default(PENDING)
  commitHash    String?          @map("commit_hash")
  createdAt     DateTime         @default(now()) @map("created_at")

  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("deployments")
}