# Required for the AI app builder module (/build, /api/generate).
# Get a key at https://console.anthropic.com — the Anthropic API is
# billed separately from any Claude.ai subscription.
ANTHROPIC_API_KEY=sk-ant-...

# Required for accounts + the workspace database module (/account,
# /api/auth/*, /api/projects). Any standard Postgres connection string
# works — Vercel Postgres, Neon, Supabase, or Railway all issue one in
# this format. The app creates its own tables on first use; no separate
# migration step needed.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Random secret used to sign session cookies. Generate one with:
# openssl rand -base64 32
JWT_SECRET=

# Search (/search) needs no environment variables of its own — it runs
# entirely inside the Postgres database above (DATABASE_URL), using
# built-in full-text search plus pg_trgm for typo tolerance if your host
# allows enabling extensions. No external search service, no extra key.

# Required for the email module's send feature (/email — the SPF/DMARC
# checker on that same page needs none of this, it's live DNS). Works
# with any real SMTP account: AWS SES, Postmark, SendGrid, Mailgun, or
# even a personal account for testing.
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Your Product <you@yourdomain.com>"

# Required for the AI voice module (/voice). Get a key at
# https://elevenlabs.io — used for real text-to-speech generation.
ELEVENLABS_API_KEY=

# Domain lookup (/domains) needs no environment variables at all — it's
# live RDAP + DNS, no account required. Buying a domain isn't wired up;
# that needs a registrar reseller account (e.g. Namecheap, Enom), which
# is a business relationship to set up separately, not just an API key.

# Optional. Used to build correct absolute URLs in the sitemap, robots.txt,
# and Open Graph tags. Set this to your real deployed URL once you have
# one (e.g. https://groundwork.yourdomain.com). Safe to leave unset —
# it falls back to a placeholder that doesn't break the build.
SITE_URL=
